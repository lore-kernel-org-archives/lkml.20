+	u8 want[PLOYTEC_PLAYBACK_FRAME_SIZE] = { 0 };
+
+	memset(dest, 0xFF, sizeof(dest));
+	ploytec_encode_batch(dest, src, 1);
+
+	KUNIT_EXPECT_MEMEQ_MSG(test, dest, want, sizeof(dest),
