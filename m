+/* Count set bits in a buffer, recording the position of the last one seen. */
+static int ploytec_count_set_bits(const u8 *buf, size_t len, int *last_pos)
+{
+	int count = 0;
+
+	for (size_t i = 0; i < len; i++) {
+		for (int b = 0; b < 8; b++) {
+			if (buf[i] & (1 << b)) {
+				count++;
+				if (last_pos)
+					*last_pos = i * 8 + b;
+			}
+		}
+	}
+
+	return count;
+}
