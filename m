-	u8 cnt, IGI;
-	bool bAdjust = true;
-	s8 TH_L2H_dmc, TH_H2L_dmc;
-	s8 Diff;
-
-	IGI = 0x50; /*  find H2L, L2H lower bound */
-	ODM_Write_DIG(pDM_Odm, IGI);
-
-	Diff = IGI_target-(s8)IGI;
-	TH_L2H_dmc = pDM_Odm->TH_L2H_ini + Diff;
-	if (TH_L2H_dmc > 10)
-		TH_L2H_dmc = 10;
