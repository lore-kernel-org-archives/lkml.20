-		break;
-	case 0x02:	/*  ToDs = 1, FromDs = 0 */
-		sa = GetAddr2Ptr(pframe);
-		break;
-	default:	/*  ToDs = 1, FromDs = 1 */
-		sa = GetAddr4Ptr(pframe);
