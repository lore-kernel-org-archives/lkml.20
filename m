-	/*  set GRAN_BT = 1 */
-	pBtCoexist->fBtcWrite1Byte(pBtCoexist, 0x765, 0x18);
-	/*  set WLAN_ACT = 0 */
-	pBtCoexist->fBtcWrite1Byte(pBtCoexist, 0x76e, 0x4);
