-{
-	int	i = 0;
-	u16 rate = 0, max_rate = 0;
-	struct mlme_priv *pmlmepriv = &adapter->mlmepriv;
-	struct wlan_bssid_ex	*pcur_bss = &pmlmepriv->cur_network.network;
-	struct sta_info *psta = NULL;
