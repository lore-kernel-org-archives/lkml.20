> --- a/arch/s390/kvm/arm64/arm.c
> +++ b/arch/s390/kvm/arm64/arm.c
> @@ -9,6 +9,7 @@
>  #include <linux/kvm_host.h>
>  #include <linux/cleanup.h>
>  #include <linux/fpu.h>
> +#include <linux/bitfield.h>
>  
