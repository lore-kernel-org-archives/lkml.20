-void EXhalbtc8723b1ant_PowerOnSetting(struct btc_coexist *pBtCoexist)
-{
-	struct btc_board_info *pBoardInfo = &pBtCoexist->boardInfo;
-	u8 u1Tmp = 0x0;
-	u16 u2Tmp = 0x0;
-
-	pBtCoexist->fBtcWrite1Byte(pBtCoexist, 0x67, 0x20);
