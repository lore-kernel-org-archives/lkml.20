+
 static struct attribute *ally_config_attrs[] = {
 	&dev_attr_xbox_controller.attr,
 	NULL
@@ -1366,6 +1709,22 @@ static struct attribute *right_joystick_axis_attrs[] = {
 	NULL
 };
 
