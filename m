-			cnt++;
-			msleep(10);
-		}
-
-		/* check the status of IPS */
-		if (rtw_hal_check_ips_status(padapter) || pwrctl->rf_pwrstate == rf_off) {
-			/* check HW status and SW state */
-			netdev_dbg(padapter->pnetdev,
