-static secno alloc_in_bmp(struct super_block *s, secno near, unsigned n, unsigned forward)
-{
-	struct quad_buffer_head qbh;
-	__le32 *bmp;
-	unsigned bs = near & ~0x3fff;
-	unsigned nr = (near & 0x3fff) & ~(n - 1);
-	/*unsigned mnr;*/
