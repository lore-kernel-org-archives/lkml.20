-int rtw_cmd_filter(struct cmd_priv *pcmdpriv, struct cmd_obj *cmd_obj)
-{
-	bool allow = false; /* set to true to allow enqueuing cmd when hw_init_completed is false */
-
-	if (cmd_obj->cmdcode == SET_CHANNEL_PLAN_CMD)
-		allow = true;
-
-	if ((!pcmdpriv->padapter->hw_init_completed && !allow) ||
-	    !atomic_read(&pcmdpriv->cmdthd_running))	/* com_thread not running */
-		return _FAIL;
-
-	return _SUCCESS;
-}
-
-int rtw_enqueue_cmd(struct cmd_priv *pcmdpriv, struct cmd_obj *cmd_obj)
-{
-	int res;
-	struct adapter *padapter = pcmdpriv->padapter;
-
-	if (!cmd_obj)
-		return _FAIL;
-
-	cmd_obj->padapter = padapter;
-
-	res = rtw_cmd_filter(pcmdpriv, cmd_obj);
-	if (res == _FAIL) {
-		rtw_free_cmd_obj(cmd_obj);
-		return _FAIL;
-	}
-
-	res = _rtw_enqueue_cmd(&pcmdpriv->cmd_queue, cmd_obj);
-
-	if (res == 0) {
-		complete(&pcmdpriv->cmd_queue_comp);
-		return _SUCCESS;
-	}
-
-	return _FAIL;
-}
-
-struct	cmd_obj	*rtw_dequeue_cmd(struct cmd_priv *pcmdpriv)
-{
-	return _rtw_dequeue_cmd(&pcmdpriv->cmd_queue);
-}
