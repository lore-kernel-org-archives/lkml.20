-static void sort_wmm_ac_params(u32 *inx, u32 *edca)
-{
-	u32 i, j, change_inx = false;
-
-	/* entry index: 0->vo, 1->vi, 2->be, 3->bk. */
-	for (i = 0; i < 4; i++) {
-		for (j = i + 1; j < 4; j++) {
-			/* compare CW and AIFS */
-			if ((edca[j] & 0xFFFF) < (edca[i] & 0xFFFF)) {
-				change_inx = true;
-			} else if ((edca[j] & 0xFFFF) == (edca[i] & 0xFFFF)) {
-				/* compare TXOP */
-				if ((edca[j] >> 16) > (edca[i] >> 16))
-					change_inx = true;
-			}
-
-			if (change_inx) {
-				swap(edca[i], edca[j]);
-				swap(inx[i], inx[j]);
-
-				change_inx = false;
-			}
-		}
-	}
-}
