-	/* Check magics */
-	if (/*le16_to_cpu(bootblock->magic) != BB_MAGIC
-	    ||*/ le32_to_cpu(superblock->magic) != SB_MAGIC
-	    || le32_to_cpu(spareblock->magic) != SP_MAGIC) {
