-	if (is_supported_ht(psta->wireless_mode)) {
-		max_rate = rtw_mcs_rate(psta->bw_mode == CHANNEL_WIDTH_40 ? 1 : 0,
-					short_GI,
-					psta->htpriv.ht_cap.mcs.rx_mask);
-	} else {
-		while ((pcur_bss->supported_rates[i] != 0) && (pcur_bss->supported_rates[i] != 0xFF)) {
