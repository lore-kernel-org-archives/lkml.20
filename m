-			err = do_trim(s, sbi->sb_dirband_start + idx * 4, len * 4, start, end, minlen, result);
-			idx += len;
-		}
-		hpfs_brelse4(&qbh);
-unlock_1:
-		hpfs_unlock(s);
-	}
-	start_bmp = start >> 14;
-	end_bmp = (end + 0x3fff) >> 14;
-	while (start_bmp < end_bmp && !err) {
-		hpfs_lock(s);
