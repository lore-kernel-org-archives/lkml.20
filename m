-		start = limit_start;
-	if (end > limit_end)
-		end = limit_end;
-	if (start >= end)
-		return 0;
-	if (end - start < minlen)
-		return 0;
-	err = sb_issue_discard(s, start, end - start, GFP_NOFS, 0);
-	if (err)
-		return err;
-	*result += end - start;
-	return 0;
-}
