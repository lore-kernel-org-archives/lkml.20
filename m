-static u32 phy_RFSerialRead_8723B(
-	struct adapter *Adapter, enum rf_path eRFPath, u32 Offset
-)
-{
-	u32 retValue = 0;
-	struct hal_com_data *pHalData = GET_HAL_DATA(Adapter);
