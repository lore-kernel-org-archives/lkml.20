-		/* here sleep 1ms will cause big TP loss of TX */
-		/* from 50+ to 40+ */
-		if (padapter->registrypriv.wifi_spec)
-			msleep(1);
-		else
-			yield();
-		goto next;
-	}
-
-	spin_lock_bh(&pxmitpriv->lock);
-	ret = rtw_txframes_pending(padapter);
