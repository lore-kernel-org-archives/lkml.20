-			}
-		} else if (result == 1) {
-			if (
-				BT_INFO_8723B_1ANT_A2DP_BASIC_RATE(btInfoExt) &&
-				((pCoexDm->curPsTdma == 1) || (pCoexDm->curPsTdma == 2))
