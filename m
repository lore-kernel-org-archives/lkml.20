-				pDM_Odm->TxHangFlg = false;
-				pDM_Odm->txEdcca1 = 0;
-				pDM_Odm->txEdcca0 = 0;
-				pDM_Odm->H2L_lb = TH_H2L_dmc;
-				pDM_Odm->L2H_lb = TH_L2H_dmc;
-				pDM_Odm->Adaptivity_IGI_upper = IGI;
-			}
-		} else {
-			bAdjust = false;
-			pDM_Odm->TxHangFlg = false;
-			pDM_Odm->txEdcca1 = 0;
-			pDM_Odm->txEdcca0 = 0;
-			pDM_Odm->H2L_lb = TH_H2L_dmc;
-			pDM_Odm->L2H_lb = TH_L2H_dmc;
-			pDM_Odm->Adaptivity_IGI_upper = IGI;
