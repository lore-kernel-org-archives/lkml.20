-		return -EINVAL;
-	}
-
-	if ((level < 1) || (level > 7)) {
-		dev_warn(bridge->parent, "Invalid interrupt level\n");
-		return -EINVAL;
-	}
-
-	if (!bridge->irq_generate) {
