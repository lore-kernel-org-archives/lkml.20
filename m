-
-	rtl8723b_fill_fake_txdesc(padapter, &ReservedPagePacket[BufIndex - TxDescLen], NullDataLength, false, false, false);
-
-	CurtPktPageNum = (u8)PageNum_128(TxDescLen + NullDataLength);
