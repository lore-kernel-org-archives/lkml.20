-
-		rtw_free_cmd_obj(pcmd);
-	} while (1);
-
-	complete(&pcmdpriv->terminate_cmdthread_comp);
-	atomic_set(&pcmdpriv->cmdthd_running, false);
-
-	return 0;
-}
