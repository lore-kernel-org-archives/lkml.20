-	struct caam_rsa_key *key = &ctx->key;
-
-	dma_unmap_single(ctx->dev, ctx->padding_dma, CAAM_RSA_MAX_INPUT_SIZE -
-			 1, DMA_TO_DEVICE);
-	caam_rsa_free_key(key);
-	caam_jr_free(ctx->dev);
-}
