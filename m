 .../net/ethernet/broadcom/bnge/bnge_vnic.h    |   1 +
 8 files changed, 365 insertions(+), 44 deletions(-)

diff --git a/drivers/net/ethernet/broadcom/bnge/bnge.h b/drivers/net/ethernet/broadcom/bnge/bnge.h
