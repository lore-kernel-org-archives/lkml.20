-		.base = {
-			.cra_name = "rsa",
-			.cra_driver_name = "rsa-caam",
-			.cra_priority = 3000,
-			.cra_module = THIS_MODULE,
-			.cra_ctxsize = sizeof(struct caam_rsa_ctx) +
-				       CRYPTO_DMA_PADDING,
-		},
