-		return -EINVAL;
-	}
-
-	if (resource->type != VME_MASTER) {
-		dev_err(bridge->parent, "Not a master resource\n");
-		return -EINVAL;
-	}
-
-	image = list_entry(resource->entry, struct vme_master_resource, list);
