-	    from_kuid(&init_user_ns, attr->ia_uid) >= 0x10000)
-		goto out_unlock;
-	if ((attr->ia_valid & ATTR_GID) &&
-	    from_kgid(&init_user_ns, attr->ia_gid) >= 0x10000)
