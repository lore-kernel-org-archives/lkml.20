-void rtw_buf_free(u8 **buf, u32 *buf_len)
-{
-	if (!buf || !buf_len)
-		return;
-
-	if (*buf) {
-		*buf_len = 0;
-		kfree(*buf);
-		*buf = NULL;
-	}
-}
